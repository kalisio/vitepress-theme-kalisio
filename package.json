{
  "name": "@kalisio/vitepress-theme",
  "description": "VitePress theme for Kalisio projects",
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "exports": {
    ".": {
      "development": "./index.js",
      "import": "./dist/index.mjs"
    },
    "./sidebar": {
      "development": "./src/sidebar.js",
      "import": "./dist/sidebar.mjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "src",
    "index.js"
  ],
  "lint-staged": {
    "**/*.js": [
      "pnpm lint"
    ]
  },
  "scripts": {
    "prebump": "changeset",
    "bump": "changeset version",
    "build": "vite build",
    "postbuild": "pnpm publint",
    "docs:install": "pnpm -C docs install",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "lint": "standard '**/*.js' --fix",
    "prepare": "husky",
    "prerelease": "pnpm build",
    "release": "changeset publish",
    "postrelease": "git push --follow-tags",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "vue",
    "vite",
    "vitepress",
    "theme",
    "kalisio"
  ],
  "author": {
    "name": "Kalisio",
    "email": "contact@kalisio.com",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalisio/vitepress-theme-kalisio.git"
  },
  "bugs": {
    "url": "https://github.com/kalisio/vitepress-theme-kalisio/issues"
  },
  "homepage": "https://github.com/kalisio/vitepress-theme-kalisio#readme",
  "dependencies": {
    "keycloak-js": "^23.0.5",
    "lodash-es": "~4.18.1",
    "moment": "^2.30.1",
    "vitepress-openapi": "~0.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "~2.30.0",
    "@vitejs/plugin-vue": "~5.2.0",
    "husky": "~9.1.7",
    "knip": "~6.7.0",
    "lint-staged": "~16.4.0",
    "publint": "~0.3.20",
    "quasar": "~2.14.3",
    "rimraf": "~6.1.3",
    "standard": "~17.1.2",
    "vite": "~5.4.0",
    "vitepress": "~1.6.0",
    "vue": "~3.5.0"
  },
  "peerDependencies": {
    "quasar": "~2.14.0",
    "vitepress": "~1.6.0",
    "vue": "~3.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./sidebar": "./dist/sidebar.mjs",
      "./style.css": "./dist/style.css"
    }
  }
}
