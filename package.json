{
  "name": "vitepress-theme-kalisio",
  "version": "1.0.0",
  "description": "VitePress theme for Kalisio projects",
  "packageManager": "pnpm@10.28.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalisio/vitepress-theme-kalisio.git"
  },
  "type": "module",
  "keywords": [
    "vue",
    "vite",
    "vitepress",
    "theme",
    "kalisio"
  ],
  "author": "Kalisio team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kalisio/vitepress-theme-kalisio/issues"
  },
  "homepage": "https://github.com/kalisio/vitepress-theme-kalisio#readme",
  "exports": {
    ".": {
      "development": "./index.js",
      "import": "./dist/index.mjs"
    },
    "./style.css": "./dist/vitepress-theme-kalisio.css"
  },
  "lint-staged": {
    "**/*.js": [
      "pnpm lint"
    ]
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "bump": "changeset version",
    "change": "changeset",
    "release": "changeset publish",
    "prepare": "husky",
    "build": "vite build",
    "lint": "standard '**/*.js' --fix",
    "postrelease": "git push --follow-tags"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@vitejs/plugin-vue": "^6.0.7",
    "husky": "^9.1.7",
    "keycloak-js": "^23.0.5",
    "lint-staged": "^17.0.7",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "quasar": "^2.14.3",
    "standard": "^17.1.2",
    "vite": "^8.0.16",
    "vitepress": "^1.3.0",
    "vue": "^3.4.0"
  },
  "peerDependencies": {
    "keycloak-js": "^23.0.5",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "quasar": "^2.14.3",
    "vitepress": "^1.3.0",
    "vue": "^3.4.0"
  }
}
