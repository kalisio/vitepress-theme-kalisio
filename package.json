{
  "name": "vitepress-theme-kalisio",
  "version": "1.0.0",
  "description": "VitePress theme for Kalisio projects",
  "packageManager": "pnpm@10.28.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalisio/vitepress-theme-kalisio.git"
  },
  "type": "module",
  "keywords": [
    "vue",
    "vite",
    "vitepress",
    "theme",
    "kalisio"
  ],
  "author": {
    "name": "Kalisio",
    "email": "contact@kalisio.com",
    "url": "https://github.com/kalisio"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kalisio/vitepress-theme-kalisio/issues"
  },
  "homepage": "https://github.com/kalisio/vitepress-theme-kalisio#readme",
  "exports": {
    ".": {
      "development": "./dist/index.mjs",
      "import": "./dist/index.mjs"
    },
    "./sidebar": "./src/sidebar.mjs",
    "./style.css": "./dist/vitepress-theme-kalisio.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs"
      },
      "./sidebar": "./src/sidebar.mjs",
      "./style.css": "./dist/vitepress-theme-kalisio.css"
    }
  },
  "lint-staged": {
    "**/*.js": [
      "pnpm lint"
    ]
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "bump": "changeset version",
    "change": "changeset",
    "release": "changeset publish",
    "prepare": "husky",
    "prepack": "vite build",
    "build": "vite build",
    "postbuild": "pnpm publint",
    "docs:build": "pnpm -C docs install && pnpm -C docs build",
    "docs:dev": "pnpm --filter docs run dev",
    "lint": "standard '**/*.js' --fix",
    "postrelease": "git push --follow-tags"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@vitejs/plugin-vue": "^6.0.7",
    "husky": "^9.1.7",
    "keycloak-js": "^23.0.5",
    "lint-staged": "^17.0.7",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "publint": "^0.3.21",
    "quasar": "^2.14.3",
    "standard": "^17.1.2",
    "vite": "^8.0.16",
    "vitepress": "^1.3.0",
    "vue": "^3.4.0"
  },
  "peerDependencies": {
    "vitepress-openapi": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "vitepress-openapi": {
      "optional": true
    }
  }
}
